{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "installCommand": "npm install",
  "env": {
    "NITRO_PRESET": "vercel"
  },
  "crons": [
    {
      "path": "/api/public/hooks/lifecycle",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/public/hooks/ai-knowledge",
      "schedule": "30 6 * * *"
    }
  ]
}
