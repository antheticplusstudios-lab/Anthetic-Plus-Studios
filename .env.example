# Frontend-safe Supabase credentials only. Never put service-role keys in VITE_* variables.
VITE_DB1_URL=https://YOUR_DB1_PROJECT.supabase.co
VITE_DB1_ANON_KEY=YOUR_DB1_ANON_OR_PUBLISHABLE_KEY

# Backend-only settings (configure in backend/.env locally or as server environment variables).
# Use distinct projects/keys for each database role. Never commit real values.
ENVIRONMENT=development
CORS_ALLOWED_ORIGINS=https://anthetic-plus-studios.vercel.app
CORS_DEV_ORIGINS=http://localhost:5173,http://localhost:8080
CORS_ALLOW_CREDENTIALS=false
FASTAPI_PORT=8000
DB1_URL=https://YOUR_DB1_PROJECT.supabase.co
DB1_ANON_KEY=YOUR_DB1_ANON_KEY
DB1_SERVICE_KEY=YOUR_DB1_SERVICE_ROLE_KEY
DB2_URL=https://YOUR_DB2_PROJECT.supabase.co
DB2_SERVICE_KEY=YOUR_DB2_SERVICE_ROLE_KEY
DB3_URL=https://YOUR_DB3_PROJECT.supabase.co
DB3_SERVICE_KEY=YOUR_DB3_SERVICE_ROLE_KEY
DB4_URL=https://YOUR_DB4_PROJECT.supabase.co
DB4_SERVICE_KEY=YOUR_DB4_SERVICE_ROLE_KEY
REDIS_URL=redis://localhost:6379/0
ALLOWED_WIDGET_HOSTS=
# Optional 32-byte base64-encoded AES key for encrypted DB3 webhook secrets.
# ANTHETICPLUS_DB3_MASTER_KEY=

# Build/deployment configuration
NITRO_PRESET=vercel
